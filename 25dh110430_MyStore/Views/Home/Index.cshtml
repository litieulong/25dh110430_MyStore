@model _25dh110430_MyStore.Models.HomeProductVM
@{
    ViewBag.Title = "Customer Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Hoặc layout tương ứng của bạn
}
<style>
    /* =========================
       CHỈ ÁP DỤNG CHO TRANG HOME
       ========================= */

    /* SẢN PHẨM NỔI BẬT */
    .feature-container {
        display: grid !important;
        grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
        gap: 20px !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
        overflow: visible !important;
    }

    /* SẢN PHẨM MỚI */
    .list-container {
        display: grid !important;
        grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
        gap: 20px !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    /* CARD SẢN PHẨM */
    .feature-container .product-item,
    .list-container .product-item {
        width: 100% !important;
        height: 350px !important;
        min-width: 0 !important;
        max-height: none !important;
        margin: 0 !important;
        padding: 0 !important;
        border: 1px solid #aaa !important;
        border-radius: 10px !important;
        box-sizing: border-box !important;
        overflow: hidden !important;
        background-color: white !important;
    }

    /* KHU VỰC ẢNH */
    .feature-container .product-item img,
    .list-container .product-item img {
        display: block !important;
        width: 100% !important;
        height: 200px !important;
        max-height: none !important;
        padding: 10px !important;
        box-sizing: border-box !important;
        object-fit: contain !important;
        background-color: white !important;
    }

    /* GIÁ */
    .feature-container .prodPrice,
    .list-container .prodPrice {
        margin: 0 !important;
        padding: 10px 5px 0 5px !important;
    }

    /* TÊN */
    .feature-container .prodName,
    .list-container .prodName {
        margin: 10px 0 0 0 !important;
        padding: 0 5px !important;
        min-height: 40px !important;
    }

    /* LOẠI */
    .feature-container .prodCate {
        margin: 5px 0 0 0 !important;
        padding: 0 5px !important;
    }

    /* ĐÃ BÁN */
    .feature-container .prodSale,
    .list-container .prodSale {
        margin: 10px 0 0 0 !important;
        padding: 0 5px !important;
    }

    @*/* Màn hình nhỏ */
    @media (max-width: 1000px) {
        .feature-container,
        .list-container {
            grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        }
    }

    @media (max-width: 700px) {
        .feature-container,
        .list-container {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
    }

    @media (max-width: 450px) {
        .feature-container,
        .list-container {
            grid-template-columns: 1fr !important;
        }*@
    }
</style>

@section Styles {
    <link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />
}

<!-- BANNER QUẢNG CÁO -->
<div style="background-color: #2b2f38; color: white; padding: 40px 20px; text-align: center; border-radius: 6px; margin-bottom: 30px;">
    <h1 style="font-size: 28px; margin-bottom: 10px; color: #e31837;">BỘ SƯU TẬP BALO DU LỊCH & LAPTOP 2026</h1>
    <p style="font-size: 16px;">Giảm giá lên đến 30% cho tất cả các dòng Balo chống nước chính hãng!</p>
</div>


<!-- PHẦN TÌM KIẾM SẢN PHẨM -->
<section class="container-fluid searchProd">
    <h2>Tìm kiếm sản phẩm</h2>
    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
    {
        <div class="form-group search-container">
            @Html.TextBoxFor(m => m.SearchTerm, new
            {
                @class = "search-input",
                placeholder = "Nhập tên, mô tả hoặc chủng loại sản phẩm"
            })
            <button type="submit" class="search-button">Tìm kiếm</button>
        </div>
    }
</section>
<hr />

<!-- PHẦN SẢN PHẨM NỔI BẬT -->
@Html.Partial("_PVFeatureProduct", Model)

<!-- PHẦN SẢN PHẨM MỚI -->
@Html.Partial("_PVNewProduct", Model)