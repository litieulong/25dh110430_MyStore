
@model _25dh110430_MyStore.Models.Customer

@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    /* CĂN GIỮA TOÀN BỘ TRANG */
    .account-page {
        min-height: 75vh;
        padding: 40px 15px;
        background: #fff;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .account-container {
        width: 100%;
        max-width: 650px;
        margin: 0 auto;
    }

    /* TIÊU ĐỀ */
    .account-title {
        text-align: center;
        margin-bottom: 30px;
    }

    /* HEADER */
    .account-card-header {
        text-align: center;
    }

    /* NỘI DUNG THÔNG TIN */
    .account-card-body {
        padding: 30px;
        text-align: center;
    }

    /* CĂN GIỮA TỪNG TRƯỜNG */
    .account-field {
        max-width: 400px;
        margin: 0 auto 23px;
    }

        .account-field label {
            display: block;
            text-align: center;
        }

        .account-field .form-control {
            width: 100%;
            height: 46px;
            text-align: center;
            margin: 0 auto;
        }

    .account-card .account-footer {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center !important;
        padding: 18px 30px;
        background: #fff;
        border-top: 1px solid #ddd;
        color: #777;
        font-size: 13px;
        box-sizing: border-box;
    }

    /* TIÊU ĐỀ */
    .account-title {
        text-align: left;
        margin-bottom: 25px;
    }

        .account-title h2 {
            font-size: 28px;
            font-weight: 700;
            color: #222;
            margin: 0 0 10px;
        }

        .account-title p {
            color: #777;
            font-size: 15px;
            margin: 0;
        }

    /* KHUNG THÔNG TIN */
    .account-card {
        background: #fff;
        border: 1px solid #00a6c7;
        border-radius: 0;
        overflow: hidden;
        box-shadow: none;
    }

    /* HEADER */
    .account-card-header {
        padding: 22px 30px;
        background: #fff;
        color: #222;
        border-bottom: 1px solid #ddd;
    }

        .account-card-header h4 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
        }

        .account-card-header p {
            margin: 8px 0 0;
            font-size: 14px;
            color: #777;
        }

    /* NỘI DUNG */
    .account-card-body {
        padding: 30px;
    }

    /* TỪNG TRƯỜNG THÔNG TIN */
    .account-field {
        margin-bottom: 23px;
    }

        .account-field:last-child {
            margin-bottom: 0;
        }

        .account-field label {
            display: block;
            color: #222;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 9px;
        }

        .account-field .form-control {
            height: 46px;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: #fafafa;
            color: #333;
            font-size: 14px;
            padding: 10px 15px;
            box-shadow: none;
            cursor: default;
        }

            .account-field .form-control:focus {
                border-color: #00a6c7;
                box-shadow: none;
                outline: none;
            }

    /* FOOTER */
    .account-footer {
        padding: 18px 30px;
        background: #fff;
        border-top: 1px solid #ddd;
        color: #777;
        font-size: 13px;
        text-align: left;
    }

    /* RESPONSIVE */
    @@media (max-width: 576px) {
        .account-page {
            padding: 25px 10px;
        }

        .account-card-body {
            padding: 22px 18px;
        }

        .account-card-header {
            padding: 20px 18px;
        }

        .account-title h2 {
            font-size: 23px;
        }
    }

</style>

<div class="account-page">
    <div class="account-container">

        <div class="account-title">
            <h2>THÔNG TIN TÀI KHOẢN</h2>
            <p>Quản lý và xem thông tin cá nhân của bạn</p>
        </div>

        <div class="account-card">

            <div class="account-card-header">
                <h4>Thông tin khách hàng</h4>
                <p>Thông tin tài khoản đang đăng nhập</p>
            </div>

            <div class="account-card-body">

                <div class="account-field">
                    <label>Tên đăng nhập</label>
                    <input type="text" class="form-control"
                           value="@Model.Username" readonly />
                </div>

                <div class="account-field">
                    <label>Họ tên</label>
                    <input type="text" class="form-control"
                           value="@Model.CustomerName" readonly />
                </div>

                <div class="account-field">
                    <label>Email</label>
                    <input type="text" class="form-control"
                           value="@Model.CustomerEmail" readonly />
                </div>

                <div class="account-field">
                    <label>Số điện thoại</label>
                    <input type="text" class="form-control"
                           value="@Model.CustomerPhone" readonly />
                </div>

                <div class="account-field">
                    <label>Địa chỉ</label>
                    <input type="text" class="form-control"
                           value="@Model.CustomerAddress" readonly />
                </div>

            </div>

            <div class="account-footer">
                Thông tin cá nhân của bạn được hiển thị tại đây.
            </div>

        </div>
    </div>
</div>
