
@model _25dh110430_MyStore.Models.Customer

@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    /* CĂN GIỮA TOÀN BỘ TRANG */
    .account-page {
        min-height: 75vh;
        padding: 40px 15px;
        background: #fff;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .account-container {
        width: 100%;
        max-width: 650px;
        margin: 0 auto;
    }

    /* TIÊU ĐỀ */
    .account-title {
        text-align: center;
        margin-bottom: 30px;
    }

    /* HEADER */
    .account-card-header {
        text-align: center;
    }

    /* NỘI DUNG THÔNG TIN */
    .account-card-body {
        padding: 30px;
        text-align: center;
    }

    /* CĂN GIỮA TỪNG TRƯỜNG */
    .account-field {
        max-width: 400px;
        margin: 0 auto 23px;
    }

        .account-field label {
            display: block;
            text-align: center;
        }

        .account-field .form-control {
            width: 100%;
            height: 46px;
            text-align: center;
            margin: 0 auto;
        }

    .account-card .account-footer {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center !important;
        padding: 18px 30px;
        background: #fff;
        border-top: 1px solid #ddd;
        color: #777;
        font-size: 13px;
        box-sizing: border-box;
    }

    /* TIÊU ĐỀ */
    .account-title {
        text-align: left;
        margin-bottom: 25px;
    }

        .account-title h2 {
            font-size: 28px;
            font-weight: 700;
            color: #222;
            margin: 0 0 10px;
        }

        .account-title p {
            color: #777;
            font-size: 15px;
            margin: 0;
        }

    /* KHUNG THÔNG TIN */
    .account-card {
        background: #fff;
        border: 1px solid #00a6c7;
        border-radius: 0;
        overflow: hidden;
        box-shadow: none;
    }

    /* HEADER */
    .account-card-header {
        padding: 22px 30px;
        background: #fff;
        color: #222;
        border-bottom: 1px solid #ddd;
    }

        .account-card-header h4 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
        }

        .account-card-header p {
            margin: 8px 0 0;
            font-size: 14px;
            color: #777;
        }

    /* NỘI DUNG */
    .account-card-body {
        padding: 30px;
    }

    /* TỪNG TRƯỜNG THÔNG TIN */
    .account-field {
        margin-bottom: 23px;
    }

        .account-field:last-child {
            margin-bottom: 0;
        }

        .account-field label {
            display: block;
            color: #222;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 9px;
        }

        .account-field .form-control {
            height: 46px;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: #fafafa;
            color: #333;
            font-size: 14px;
            padding: 10px 15px;
            box-shadow: none;
            cursor: default;
        }

            .account-field .form-control:focus {
                border-color: #00a6c7;
                box-shadow: none;
                outline: none;
            }
    /* KHU VỰC NÚT CHỈNH SỬA */
    .account-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 25px;
        flex-wrap: wrap;
    }

    .btn-edit-account,
    .btn-save-account,
    .btn-cancel-account {
        padding: 12px 25px;
        border: 1px solid #00a6c7;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

    .btn-edit-account,
    .btn-save-account {
        background: #00a6c7;
        color: white;
    }

        .btn-edit-account:hover,
        .btn-save-account:hover {
            background: #0089a5;
            color: white;
        }

    .btn-cancel-account {
        background: white;
        color: #d64545;
        border-color: #d64545;
    }

        .btn-cancel-account:hover {
            background: #d64545;
            color: white;
        }

    .account-field .form-control.editing {
        background: white;
        border-color: #00a6c7;
        cursor: text;
    }

    .account-message {
        margin-bottom: 20px;
        padding: 12px;
        text-align: center;
    }
    /* FOOTER */
    .account-footer {
        padding: 18px 30px;
        background: #fff;
        border-top: 1px solid #ddd;
        color: #777;
        font-size: 13px;
        text-align: left;
    }

    /* RESPONSIVE */
    @@media (max-width: 576px) {
        .account-page {
            padding: 25px 10px;
        }

        .account-card-body {
            padding: 22px 18px;
        }

        .account-card-header {
            padding: 20px 18px;
        }

        .account-title h2 {
            font-size: 23px;
        }
    }

</style>

<div class="account-page">
    <div class="account-container">

        <div class="account-title">
            <h2>THÔNG TIN TÀI KHOẢN</h2>
            <p>Quản lý và xem thông tin cá nhân của bạn</p>
        </div>

        <div class="account-card">

            <div class="account-card-header">
                <h4>Thông tin khách hàng</h4>
                <p>Thông tin tài khoản đang đăng nhập</p>
            </div>

            <div class="account-card-body">


                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success account-message">
                        @TempData["Success"]
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger account-message">
                        @ViewBag.Error
                    </div>
                }

                <form action="@Url.Action("UpdateProfile", "Account")"
                      method="post"
                      id="profileForm">

                    @Html.AntiForgeryToken()

                    <div class="account-card-body">

                        <div class="account-field">
                            <label>Tên đăng nhập</label>
                            <input type="text" class="form-control"
                                   value="@Model.Username" readonly />
                        </div>

                        <div class="account-field">
                            <label>Họ tên</label>
                            <input type="text" name="customerName"
                                   class="form-control editable-field"
                                   value="@Model.CustomerName" readonly required />
                        </div>

                        <div class="account-field">
                            <label>Email</label>
                            <input type="email" name="customerEmail"
                                   class="form-control editable-field"
                                   value="@Model.CustomerEmail" readonly required />
                        </div>

                        <div class="account-field">
                            <label>Số điện thoại</label>
                            <input type="text" name="customerPhone"
                                   class="form-control editable-field"
                                   value="@Model.CustomerPhone" readonly required />
                        </div>

                        <div class="account-field">
                            <label>Địa chỉ</label>
                            <input type="text" name="customerAddress"
                                   class="form-control editable-field"
                                   value="@Model.CustomerAddress" readonly required />
                        </div>

                        <div class="account-actions">

                            <button type="button"
                                    class="btn-edit-account"
                                    id="btnEdit"
                                    onclick="enableEdit()">
                                <i class="glyphicon glyphicon-pencil"></i>
                                Chỉnh sửa thông tin
                            </button>

                            <button type="submit"
                                    class="btn-save-account"
                                    id="btnSave"
                                    style="display:none;">
                                <i class="glyphicon glyphicon-floppy-disk"></i>
                                Lưu thay đổi
                            </button>

                            <button type="button"
                                    class="btn-cancel-account"
                                    id="btnCancel"
                                    style="display:none;"
                                    onclick="cancelEdit()">
                                Hủy
                            </button>

                        </div>

                    </div>

                    <div class="account-footer">
                        Thông tin cá nhân của bạn được bảo mật.
                    </div>

                </form>

                <script>var originalValues = [];

    function enableEdit() {

        var fields = document.querySelectorAll(".editable-field");

        originalValues = [];

        fields.forEach(function (field) {
            originalValues.push(field.value);

            field.readOnly = false;
            field.classList.add("editing");
        });

        document.getElementById("btnEdit").style.display = "none";
        document.getElementById("btnSave").style.display = "inline-block";
        document.getElementById("btnCancel").style.display = "inline-block";
    }

    function cancelEdit() {

        var fields = document.querySelectorAll(".editable-field");

        fields.forEach(function (field, index) {
            field.value = originalValues[index];

            field.readOnly = true;
            field.classList.remove("editing");
        });

        document.getElementById("btnEdit").style.display = "inline-block";
        document.getElementById("btnSave").style.display = "none";
        document.getElementById("btnCancel").style.display = "none";
    }</script>
