@model IEnumerable<_25dh110430_MyStore.Models.Product>

@{
    ViewBag.Title = "Balo Du Lịch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top:100px;">

    <h2>BALO DU LỊCH</h2>

    <p>Số sản phẩm tìm được: @ViewBag.Count</p>

    <hr />

    @if (Model != null && Model.Any())
    {
        <div class="row">

            @foreach (var product in Model)
            {
                <div class="col-md-4">

                    <div style="border:1px solid #ddd;
                                padding:15px;
                                margin-bottom:30px;">

                        @if (!string.IsNullOrEmpty(product.ProductImage))
                         {
                            <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                                <img src="@product.ProductImage"
                                     style="width:100%;
                            height:250px;
                            object-fit:contain;
                            cursor:pointer;" />
                            </a>
                         }

                        <h3>@product.ProductName</h3>

                        <p>
                            Giá:
                            <strong>
                                @product.ProductPrice.ToString("N0") VNĐ
                            </strong>
                        </p>

                        <p>
                            CategoryID: @product.CategoryID
                        </p>



                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <h3 style="color:red;">
            Không tìm thấy sản phẩm Balo Du Lịch.
        </h3>
    }

</div>