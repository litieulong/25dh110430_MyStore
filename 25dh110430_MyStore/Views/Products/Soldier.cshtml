@model IEnumerable<_25dh110430_MyStore.Models.Product>
@using System.Linq

@{
    ViewBag.Title = ViewBag.CategoryName ?? "Balo Dựng Laptop";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .camera-layout {
        display: grid;
        grid-template-columns: 250px minmax(0, 1fr);
        gap: 25px;
    }

    .camera-sidebar {
        background: white;
        padding: 22px;
        border-radius: 12px;
        height: fit-content;
        box-shadow: 0 3px 12px rgba(0,0,0,0.06);
    }

        .camera-sidebar h3 {
            font-size: 17px;
            font-weight: bold;
            color: #263f53;
            margin: 0 0 18px;
        }

    .camera-search-input {
        width: 100%;
        padding: 11px;
        border: 1px solid #ddd;
        border-radius: 7px;
        margin-bottom: 12px;
        outline: none;
    }

    .camera-search-button {
        width: 100%;
        padding: 11px;
        border: none;
        border-radius: 7px;
        background: #263f53;
        color: white;
        font-weight: bold;
        cursor: pointer;
    }

        .camera-search-button:hover {
            background: #385b75;
        }

    .camera-sort-button {
        display: block;
        width: 100%;
        padding: 9px 5px;
        margin: 0;
        border: none;
        border-radius: 0;
        background: transparent;
        color: #555;
        font-size: 14px;
        font-weight: normal;
        text-align: left;
        cursor: pointer;
        transition: 0.2s;
    }

        .camera-sort-button:hover {
            background: #f5f7f9;
            color: #263f53;
            padding-left: 12px;
        }

    .camera-reset-button {
        display: block;
        text-align: center;
        margin-top: 10px;
        padding: 9px;
        color: #263f53;
        background: #f1f3f5;
        border-radius: 7px;
        text-decoration: none;
    }

        .camera-reset-button:hover {
            background: #e2e6ea;
            color: #263f53;
            text-decoration: none;
        }

    .camera-sidebar-divider {
        margin: 22px 0;
        border-top: 1px solid #eee;
    }

    .camera-main {
        min-width: 0;
    }

    .camera-result-title {
        font-size: 25px;
        font-weight: bold;
        color: #263f53;
        margin-top: 0;
    }

    .camera-result-count {
        color: #777;
        margin-bottom: 20px;
    }

    .camera-product-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    .camera-product-item {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(0,0,0,0.06);
        transition: 0.25s;
    }

        .camera-product-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        }

    .camera-product-image {
        height: 220px;
        background: #f7f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px;
    }

        .camera-product-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .camera-product-info {
        padding: 16px;
    }

    .camera-product-name {
        color: #263f53;
        font-size: 16px;
        font-weight: bold;
        height: 44px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .camera-product-price {
        color: #e05252;
        font-size: 18px;
        font-weight: bold;
        margin-top: 12px;
    }

    .camera-product-category {
        color: #888;
        font-size: 13px;
    }

    .camera-empty {
        background: white;
        padding: 30px;
        text-align: center;
        border-radius: 10px;
        color: #777;
    }

    @@media (max-width: 992px) {
        .camera-layout {
            grid-template-columns: 210px minmax(0, 1fr);
        }

        .camera-product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 576px) {
        .camera-layout {
            grid-template-columns: 1fr;
        }

        .camera-product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .camera-product-image {
            height: 150px;
        }

        .camera-product-info {
            padding: 10px;
        }
    }
</style>

<div class="container" style="margin-top:100px;">

    <div class="camera-layout">

        <!-- SIDEBAR BÊN TRÁI -->
        <aside class="camera-sidebar">

            <h3>TÌM KIẾM SẢN PHẨM</h3>

            <form action="@Url.Content("~/Products/Soldier")" method="get">

                <input type="text"
                       name="searchTerm"
                       value="@Request.QueryString["searchTerm"]"
                       class="camera-search-input"
                       placeholder="Nhập tên sản phẩm..." />

                <input type="hidden"
                       name="sortOrder"
                       value="@Request.QueryString["sortOrder"]" />

                <button type="submit" class="camera-search-button">
                    Tìm kiếm
                </button>
            </form>

            <!-- ĐẶT LẠI -->
            <a href="@Url.Content("~/Products/Soildier")"
               class="camera-reset-button">
                <i class="fa fa-refresh"></i>
                Đặt lại
            </a>

            <hr class="camera-sidebar-divider" />

            <!-- SẮP XẾP -->
            <h3>SẮP XẾP SẢN PHẨM</h3>

            <form action="@Url.Content("~/Products/Soldier")" method="get">

                <input type="hidden"
                       name="searchTerm"
                       value="@Request.QueryString["searchTerm"]" />

                <button type="submit" name="sortOrder"
                        value="price_asc" class="camera-sort-button">
                    Giá thấp đến cao
                </button>

                <button type="submit" name="sortOrder"
                        value="price_desc" class="camera-sort-button">
                    Giá cao đến thấp
                </button>

                <button type="submit" name="sortOrder"
                        value="name_asc" class="camera-sort-button">
                    Tên A - Z
                </button>

                <button type="submit" name="sortOrder"
                        value="" class="camera-sort-button">
                    Mặc định
                </button>
            </form>

        </aside>

        <!-- DANH SÁCH SẢN PHẨM -->
        <main class="camera-main">

            @*<h2 class="camera-result-title">
                @ViewBag.CategoryName
            </h2>

            <p class="camera-result-count">
                Số sản phẩm tìm được: @ViewBag.Count
            </p>*@

            @if (Model != null && Model.Any())
            {
                <div class="camera-product-grid">

                    @foreach (var product in Model)
                    {
                        <div class="camera-product-item">

                            <a href="@Url.Action(
                                "ProductDetails", "Home",
                                new { id = product.ProductID })">

                                <div class="camera-product-image">

                                    @if (!string.IsNullOrEmpty(product.ProductImage))
                                    {
                                        <img src="@product.ProductImage"
                                             alt="@product.ProductName" />
                                    }

                                </div>
                            </a>

                            <div class="camera-product-info">

                                <div class="camera-product-name">
                                    @product.ProductName
                                </div>

                                <div class="camera-product-price">
                                    @product.ProductPrice.ToString("N0") VNĐ
                                </div>

                                <div class="camera-product-category">
                                    Danh mục: @ViewBag.CategoryName
                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="camera-empty">

                    <i class="glyphicon glyphicon-search"
                       style="font-size:30px;"></i>

                    <h4>Không tìm thấy sản phẩm</h4>

                    <p>Vui lòng thử từ khóa tìm kiếm khác.</p>

                </div>
            }

        </main>

    </div>
</div>

