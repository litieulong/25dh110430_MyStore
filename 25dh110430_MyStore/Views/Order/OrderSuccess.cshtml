@model _25dh110430_MyStore.Models.Order

@{
    ViewBag.Title = "OrderSuccess";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .success-page {
        background: #fff;
        padding: 35px 0 60px;
        color: #222;
    }

    .success-title {
        font-size: 27px;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 15px;
    }

    .success-message {
        color: #399b65;
        font-size: 16px;
        margin-bottom: 30px;
    }

    /* Khung thông tin đơn hàng */
    .order-info-box {
        border: 2px solid #009fbd;
        padding: 25px 30px;
        margin-bottom: 35px;
    }

    .section-title {
        font-size: 21px;
        font-weight: 700;
        text-transform: uppercase;
        margin: 0 0 22px;
        padding-bottom: 12px;
        border-bottom: 2px solid #e8e8e8;
    }

    .order-info-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 30px;
    }

    .order-info-item {
        font-size: 16px;
        line-height: 1.6;
    }

        .order-info-item strong {
            color: #222;
        }

    .order-status {
        color: #d58a22;
        font-weight: 700;
    }

    .order-total-price {
        color: #c83d1c;
        font-size: 19px;
        font-weight: 700;
    }

    /* Bảng chi tiết đơn hàng */
    .order-detail-box {
        margin-bottom: 30px;
    }

    .success-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

        .success-table thead {
            background: #f7f7f7;
        }

        .success-table th {
            padding: 16px 15px;
            text-align: left;
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            border-bottom: 2px solid #ddd;
        }

        .success-table td {
            padding: 17px 15px;
            border-bottom: 1px solid #e5e5e5;
            font-size: 15px;
            vertical-align: middle;
        }

        .success-table tbody tr:hover {
            background: #fafafa;
        }

        .success-table th:not(:first-child),
        .success-table td:not(:first-child) {
            text-align: center;
        }

    .product-name {
        font-weight: 600;
        color: #009bb5;
    }

    .product-price {
        font-weight: 600;
        white-space: nowrap;
    }

    .order-final-total {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 25px;
        padding: 20px 15px;
        border-bottom: 2px solid #e5e5e5;
        font-size: 18px;
    }

        .order-final-total strong {
            color: #c83d1c;
            font-size: 21px;
        }

    /* Nút điều hướng */
    .success-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 30px;
    }

    .success-button {
        display: inline-block;
        padding: 13px 25px;
        font-size: 15px;
        font-weight: 700;
        text-transform: uppercase;
        text-decoration: none;
        text-align: center;
        border: 2px solid #009fbd;
        transition: 0.2s;
    }

    .home-button {
        background: white;
        color: #009fbd;
    }

        .home-button:hover {
            background: #009fbd;
            color: white;
            text-decoration: none;
        }

    .shopping-button {
        background: #c83d1c;
        color: white;
        border-color: #c83d1c;
    }

        .shopping-button:hover {
            background: #a92f14;
            color: white;
            text-decoration: none;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .order-info-list {
            grid-template-columns: 1fr;
        }

        .order-info-box {
            padding: 20px 15px;
        }

        .order-detail-box {
            overflow-x: auto;
        }

        .success-table {
            min-width: 600px;
        }

        .success-actions {
            flex-direction: column;
        }

        .success-button {
            width: 100%;
        }
    }
</style>

<div class="success-page">
    <div class="container">

        <h2 class="success-title">
            XÁC NHẬN ĐƠN HÀNG
        </h2>

        <p class="success-message">
            Đơn hàng của bạn đã được ghi nhận. Cảm ơn bạn đã mua sắm!
        </p>

        <!-- THÔNG TIN ĐƠN HÀNG -->
        <div class="order-info-box">

            <h3 class="section-title">
                THÔNG TIN ĐƠN HÀNG
            </h3>

            <div class="order-info-list">

                <div class="order-info-item">
                    <strong>Mã đơn hàng:</strong>
                    @Model.OrderID
                </div>

                <div class="order-info-item">
                    <strong>Ngày đặt hàng:</strong>
                    @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
                </div>

                <div class="order-info-item">
                    <strong>Trạng thái thanh toán:</strong>
                    <span class="order-status">
                        @Model.PaymentStatus
                    </span>
                </div>

                <div class="order-info-item">
                    <strong>Địa chỉ giao hàng:</strong>
                    @Model.AddressDelivery
                </div>

            </div>

            <div class="order-final-total">
                <span>Tổng số tiền:</span>

                <strong>
                    @Model.TotalAmount.ToString("N0") VNĐ
                </strong>
            </div>

        </div>

        <!-- CHI TIẾT ĐƠN HÀNG -->
        <div class="order-detail-box">

            <h3 class="section-title">
                CHI TIẾT ĐƠN HÀNG
            </h3>

            <table class="success-table">

                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Tổng giá</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.OrderDetails)
                    {
                        <tr>
                            <td>@item.Product.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                            <td>@((item.Quantity * item.UnitPrice).ToString("N0")) VNĐ</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <!-- NÚT ĐIỀU HƯỚNG -->
        <div class="success-actions">

            @Html.ActionLink(
                     "← QUAY VỀ TRANG CHỦ",
                     "Index",
                     "Home",
                     null,
                     new { @class = "success-button home-button" })

            @Html.ActionLink(
                     "TIẾP TỤC MUA SẮM",
                     "Index",
                     "Home",
                     null,
                     new { @class = "success-button shopping-button" })

        </div>

    </div>
</div>