@model IEnumerable<_25dh110430_MyStore.Models.Order>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<style>
    /*.order-page {
        background: #f5f7fb;
        min-height: 100vh;
        padding: 30px;
        border-radius: 12px;
    }*/

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .order-title {
        font-size: 25px;
        font-weight: 700;
        color: #243247;
        margin: 0;
    }

    .order-subtitle {
        color: #8a94a6;
        font-size: 14px;
        margin-top: 6px;
    }

    .order-count {
        background: #e8efff;
        color: #3563d9;
        padding: 9px 16px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 14px;
    }

    .order-card {
        background: #fff;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(30, 50, 80, 0.06);
        overflow-x: auto;
        border: none;
    }

    .order-table {
        width: 100%;
        min-width: 950px;
        border-collapse: separate;
        border-spacing: 0;
        margin-bottom: 0;
        border: none;
    }

        .order-table thead th {
            border: none !important;
        }

            .order-table thead th:first-child {
                border-radius: 8px 0 0 8px;
            }

            .order-table thead th:last-child {
                border-radius: 0 8px 8px 0;
            }

        .order-table tbody td {
            padding: 17px 12px;
            vertical-align: middle;
            border: none;
            color: #475467;
            font-size: 14px;
        }

        .order-table tbody tr:hover {
            background: #fafbff;
        }

    .order-id {
        color: #3563d9;
        font-weight: 700;
    }

    .customer-name {
        color: #243247;
        font-weight: 600;
    }

    .order-price {
        color: #16a36a;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-badge {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-waiting {
        background: #fff4d6;
        color: #b7791f;
    }

    .status-confirmed {
        background: #e8efff;
        color: #3563d9;
    }

    .status-shipping {
        background: #f0eaff;
        color: #7952c7;
    }

    .status-delivered {
        background: #dcfce7;
        color: #15803d;
    }

    .status-cancelled {
        background: #fee2e2;
        color: #dc2626;
    }

    .payment-status {
        color: #475467;
        font-weight: 500;
    }

    .status-select {
        min-width: 145px;
        border: 1px solid #dce2eb;
        border-radius: 7px;
        padding: 8px 10px;
        font-size: 13px;
        outline: none;
        background: #fff;
        color: #344054;
    }

        .status-select:focus {
            border-color: #5b83e8;
            box-shadow: 0 0 0 3px rgba(53, 99, 217, 0.1);
        }

    .btn-update {
        display: inline-block;
        margin-top: 7px;
        padding: 7px 13px;
        background: #3563d9;
        color: white;
        border: none;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-update:hover {
            background: #244db5;
            color: white;
        }

    .cancel-label {
        display: inline-block;
        background: #fee2e2;
        color: #dc2626;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
    }

    .empty-orders {
        text-align: center;
        padding: 45px 15px !important;
        color: #98a2b3 !important;
    }

    @@media (max-width: 768px) {
        .order-page {
            padding: 15px;
        }

        .order-card {
            padding: 12px;
        }

        .order-title {
            font-size: 21px;
        }
    }
</style>

<div class="order-page">

    <div class="order-header">
        <div>
            <h2 class="order-title">QUẢN LÝ ĐƠN HÀNG</h2>
            <p class="order-subtitle">
                Theo dõi và cập nhật trạng thái các đơn hàng của khách hàng
            </p>
        </div>

        <div class="order-count">
            Tổng số: @Model.Count() đơn hàng
        </div>
    </div>

    <div class="order-card">
        <table class="order-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái đơn hàng</th>
                    <th>Cập nhật</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <span class="order-id">#@order.OrderID</span>
                            </td>

                            <td>
                                <span class="customer-name">
                                    @(order.Customer != null
                                        ? order.Customer.CustomerName
                                        : "Không xác định")
                                </span>
                            </td>

                            <td>
                                @order.OrderDate.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                <span class="order-price">
                                    @order.TotalAmount.ToString("N0") VNĐ
                                </span>
                            </td>

                            <td>
                                <span class="payment-status">
                                    @order.PaymentStatus
                                </span>
                            </td>

                            <td>
                                @{
                                    string statusClass = "status-waiting";

                                    switch (order.OrderStatus)
                                    {
                                        case "Đã xác nhận":
                                            statusClass = "status-confirmed";
                                            break;

                                        case "Đang giao hàng":
                                            statusClass = "status-shipping";
                                            break;

                                        case "Đã giao hàng":
                                            statusClass = "status-delivered";
                                            break;

                                        case "Đã hủy":
                                            statusClass = "status-cancelled";
                                            break;
                                    }
                                }

                                <span class="status-badge @statusClass">
                                    @order.OrderStatus
                                </span>
                            </td>

                            <td>
                                @if (order.OrderStatus == "Đã hủy")
                                {
                                    <span class="cancel-label">
                                        Đơn hàng đã hủy
                                    </span>
                                }
                                else
                                {
                                    using (Html.BeginForm(
                                        "UpdateStatus",
                                        "Orders",
                                        new { area = "Admin", id = order.OrderID },
                                        FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()

                                        <select name="orderStatus"
                                                class="status-select">
                                            <option value="Chờ xác nhận"
                                                    @(order.OrderStatus == "Chờ xác nhận" ? "selected" : "")>
                                                Chờ xác nhận
                                            </option>

                                            <option value="Đã xác nhận"
                                                    @(order.OrderStatus == "Đã xác nhận" ? "selected" : "")>
                                                Đã xác nhận
                                            </option>

                                            <option value="Đang giao hàng"
                                                    @(order.OrderStatus == "Đang giao hàng" ? "selected" : "")>
                                                Đang giao hàng
                                            </option>

                                            <option value="Đã giao hàng"
                                                    @(order.OrderStatus == "Đã giao hàng" ? "selected" : "")>
                                                Đã giao hàng
                                            </option>

                                            <option value="Đã hủy"
                                                    @(order.OrderStatus == "Đã hủy" ? "selected" : "")>
                                                Đã hủy
                                            </option>
                                        </select>

                                        <button type="submit" class="btn-update">
                                            Cập nhật
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="empty-orders">
                            Chưa có đơn hàng nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
