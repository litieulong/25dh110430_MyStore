
@model IEnumerable<_25dh110430_MyStore.Models.Order>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<div class="container-fluid">
    <h2>QUẢN LÝ ĐƠN HÀNG</h2>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Thanh toán</th>
                <th>Trạng thái đơn hàng</th>
                <th>Cập nhật</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>#@order.OrderID</td>

                    <td>
                        @(order.Customer != null
                            ? order.Customer.CustomerName
                            : "Không xác định")
                    </td>

                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>

                    <td>
                        @order.TotalAmount.ToString("N0") VNĐ
                    </td>

                    <td>@order.PaymentStatus</td>

                    <td>@order.OrderStatus</td>

                    <td>
                        @using (Html.BeginForm(
                            "UpdateStatus",
                            "Orders",
                            new { area = "Admin", id = order.OrderID },
                            FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <select name="orderStatus" class="form-control">
                                <option value="Chờ xác nhận"
                                        @(order.OrderStatus == "Chờ xác nhận" ? "selected" : "")>
                                    Chờ xác nhận
                                </option>

                                <option value="Đã xác nhận"
                                        @(order.OrderStatus == "Đã xác nhận" ? "selected" : "")>
                                    Đã xác nhận
                                </option>

                                <option value="Đang giao hàng"
                                        @(order.OrderStatus == "Đang giao hàng" ? "selected" : "")>
                                    Đang giao hàng
                                </option>

                                <option value="Đã giao hàng"
                                        @(order.OrderStatus == "Đã giao hàng" ? "selected" : "")>
                                    Đã giao hàng
                                </option>

                                <option value="Đã hủy"
                                        @(order.OrderStatus == "Đã hủy" ? "selected" : "")>
                                    Đã hủy
                                </option>
                            </select>

                            <button type="submit"
                                    class="btn btn-primary btn-sm"
                                    style="margin-top:5px;">
                                Cập nhật
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
