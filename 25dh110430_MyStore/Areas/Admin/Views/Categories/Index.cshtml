
@model IEnumerable<_25dh110430_MyStore.Models.Category>

@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<style>
    /*.category-page {
        padding: 25px;
        background: #f5f7fb;
        min-height: 80vh;
    }*/

    /* TIÊU ĐỀ */
    .category-title {
        font-size: 25px;
        font-weight: 700;
        color: #263f53;
        margin: 0 0 8px;
    }

    .category-subtitle {
        color: #8993a4;
        font-size: 14px;
        margin-bottom: 25px;
    }

    /* KHUNG DANH SÁCH */
    .category-card {
        background: white;
        padding: 22px;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.05);
    }

    .category-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 20px;
    }

    .category-card-title {
        font-size: 17px;
        font-weight: 700;
        color: #263f53;
        margin: 0;
    }

    /* NÚT THÊM MỚI */
    .category-add-button {
        display: inline-block;
        padding: 10px 18px;
        background: #263f53;
        color: white;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .category-add-button:hover {
            background: #385b75;
            color: white;
            text-decoration: none;
        }

    /* BẢNG */
    .category-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .category-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0;
    }

        .category-table thead {
            background: #f3f6fa;
        }

        .category-table th {
            padding: 15px;
            color: #536176;
            font-size: 13px;
            font-weight: 700;
            border-bottom: 1px solid #e8edf3;
            text-align: left;
        }

        .category-table td {
            padding: 15px;
            color: #4b5563;
            font-size: 14px;
            border-bottom: 1px solid #edf0f4;
            vertical-align: middle;
        }

        .category-table tbody tr:hover {
            background: #f8fafc;
        }

        .category-table tbody tr:last-child td {
            border-bottom: none;
        }

    .category-name {
        font-weight: 600;
        color: #263f53 !important;
    }

    .category-number {
        width: 80px;
        color: #8993a4 !important;
    }

    .category-actions {
        white-space: nowrap;
    }

    /* NÚT SỬA */
    .category-edit-button {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 6px;
        background: #eaf3fb;
        color: #2874a6;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        margin-right: 5px;
    }

        .category-edit-button:hover {
            background: #d5e8f8;
            color: #1b5d89;
            text-decoration: none;
        }

    /* NÚT XÓA */
    .category-delete-button {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 6px;
        background: #fdecea;
        color: #c0392b;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

        .category-delete-button:hover {
            background: #f8d7d4;
            color: #a93226;
            text-decoration: none;
        }

    /* TRỐNG DỮ LIỆU */
    .category-empty {
        text-align: center;
        padding: 35px !important;
        color: #999 !important;
    }

    @@media (max-width: 768px) {
        .category-page {
            padding: 15px;
        }

        .category-card {
            padding: 15px;
        }

        .category-title {
            font-size: 21px;
        }
    }
</style>

<div class="category-page">

    <!-- TIÊU ĐỀ -->
    <div>
        <h2 class="category-title">
            DANH SÁCH DANH MỤC SẢN PHẨM
        </h2>

        <p class="category-subtitle">
            Quản lý và cập nhật các danh mục sản phẩm trong cửa hàng.
        </p>
    </div>

    <!-- KHUNG DANH SÁCH -->
    <div class="category-card">

        <div class="category-card-header">

            <h4 class="category-card-title">
                <i class="glyphicon glyphicon-th-list"></i>
                Danh sách danh mục
            </h4>

            @Html.ActionLink(
                     "＋ Thêm danh mục",
                     "Create",
                     null,
                     new { @class = "category-add-button" }
                 )

        </div>

        <div class="category-table-wrapper">

            <table class="category-table">

                <thead>
                    <tr>
                        <th class="category-number">STT</th>
                        <th>TÊN DANH MỤC</th>
                        <th style="width:180px;">THAO TÁC</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;

                        foreach (var item in Model)
                        {
                            <tr>

                                <td class="category-number">
                                    @stt
                                </td>

                                <td class="category-name">
                                    @Html.DisplayFor(modelItem => item.CategoryName)
                                </td>

                                <td class="category-actions">

                                    @Html.ActionLink(
                                             "Sửa",
                                             "Edit",
                                             new { id = item.CategoryID },
                                             new { @class = "category-edit-button" }
                                         )

                                    @Html.ActionLink(
                                             "Xóa",
                                             "Delete",
                                             new { id = item.CategoryID },
                                             new { @class = "category-delete-button" }
                                         )

                                </td>

                            </tr>

                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="category-empty">
                                <i class="glyphicon glyphicon-folder-open"
                                   style="font-size:28px;"></i>

                                <h4>Chưa có danh mục sản phẩm</h4>

                                <p>Hãy thêm danh mục mới để bắt đầu quản lý.</p>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>
