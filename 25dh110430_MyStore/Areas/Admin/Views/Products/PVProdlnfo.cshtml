@model _25dh110430_MyStore.Models.Product
<head>
    <style>
        img{
            height: 250px;
            max-width: 250px;
        }
    </style>
</head>
<div class="container-fluid">
    <dl class="dl-horizontal">
        <img src="@Html.DisplayFor(model => model.ProductImage)" />
        <dt>
            Tên sản phẩm
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ProductName)
        </dd>

        <dt>
            Mô tả
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ProductDescription)
        </dd>

        <dt>
            Đơn giá
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ProductPrice)
        </dd>


        <dt>
            Danh mục
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Category.CategoryName)
        </dd>

        <dt style="padding:10px"></dt>
        <dd style="padding:10px"></dd>



    </dl>
</div>
