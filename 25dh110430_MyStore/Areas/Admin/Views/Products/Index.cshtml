
@model _25dh110430_MyStore.Models.ViewModel.ProductSearchVM

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<style>

    /* TIÊU ĐỀ */
    .product-header {
        margin-bottom: 25px;
    }

    .product-title {
        font-size: 25px;
        font-weight: 700;
        color: #263f53;
        margin: 0 0 8px;
    }

    .product-subtitle {
        color: #8993a4;
        font-size: 14px;
        margin: 0;
    }

    /* KHUNG TÌM KIẾM */
    .product-search-card {
        background: white;
        padding: 22px;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.05);
        margin-bottom: 22px;
    }

    .search-title {
        font-size: 17px;
        font-weight: 700;
        color: #263f53;
        margin: 0 0 18px;
    }

    .search-container {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

        .search-container .form-control {
            width: 220px;
            height: 42px;
            border: 1px solid #dfe4ea;
            border-radius: 7px;
            box-shadow: none;
            font-size: 13px;
            padding: 8px 12px;
        }

            .search-container .form-control:focus {
                border-color: #426b9e;
                box-shadow: 0 0 0 2px rgba(66,107,158,0.1);
            }

    /* NÚT TÌM KIẾM */
    .btn-search {
        height: 42px;
        padding: 0 20px;
        background: #263f53;
        color: white;
        border: none;
        border-radius: 7px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-search:hover {
            background: #385b75;
            color: white;
        }

    /* NÚT ĐẶT LẠI */
    .btn-reset {
        height: 42px;
        padding: 0 18px;
        background: #eef1f5;
        color: #536176;
        border-radius: 7px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
    }

        .btn-reset:hover {
            background: #dfe4ea;
            color: #263f53;
            text-decoration: none;
        }

    /* KHU VỰC SẮP XẾP */
    .sort-container {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
        padding-top: 18px;
        border-top: 1px solid #edf0f4;
    }

    .sort-label {
        color: #536176;
        font-size: 13px;
        font-weight: 700;
        margin-right: 3px;
    }

    .sort-link {
        display: inline-block;
        padding: 9px 14px;
        border-radius: 7px;
        background: #eef1f5;
        color: #536176;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .sort-link:hover {
            background: #263f53;
            color: white;
            text-decoration: none;
        }

    /* KHUNG DANH SÁCH */
    .product-list-card {
        background: white;
        padding: 22px;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.05);
        overflow-x: auto;
    }

    .list-title {
        font-size: 17px;
        font-weight: 700;
        color: #263f53;
        margin: 0 0 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #edf0f4;
    }

    /* RESPONSIVE */
    @@media (max-width: 768px) {
        .product-page {
            padding: 15px;
        }

        .product-title {
            font-size: 21px;
        }

        .search-container {
            align-items: stretch;
            flex-direction: column;
        }

            .search-container .form-control,
            .search-container .btn-search,
            .search-container .btn-reset {
                width: 100%;
            }

        .sort-container {
            align-items: flex-start;
        }

        .product-list-card,
        .product-search-card {
            padding: 15px;
        }
    }
</style>

<div class="product-page">

    <!-- TIÊU ĐỀ -->
    <div class="product-header">

        <h2 class="product-title">
            QUẢN LÝ SẢN PHẨM
        </h2>

        <p class="product-subtitle">
            Tìm kiếm, lọc và sắp xếp danh sách sản phẩm trong cửa hàng.
        </p>

    </div>

    <!-- TÌM KIẾM VÀ SẮP XẾP -->
    <div class="product-search-card">

        <h4 class="search-title">
            <i class="glyphicon glyphicon-search"></i>
            Tìm kiếm sản phẩm
        </h4>

        @using (Html.BeginForm(
            "Index",
            "Products",
            new { area = "Admin" },
            FormMethod.Get))
        {
            <div class="search-container">

                @Html.TextBox("searchTerm", Model.SearchTerm, new
                {
                    @class = "form-control",
                    placeholder = "Tên, mô tả hoặc chủng loại"
                })

                @Html.TextBox("minPrice", Model.MinPrice, new
                {
                    @class = "form-control",
                    placeholder = "Giá tối thiểu",
                    type = "number",
                    min = "0"
                })

                @Html.TextBox("maxPrice", Model.MaxPrice, new
                {
                    @class = "form-control",
                    placeholder = "Giá tối đa",
                    type = "number",
                    min = "0"
                })

                <button type="submit" class="btn-search">
                    <i class="glyphicon glyphicon-search"></i>
                    Tìm kiếm
                </button>

                <a href="@Url.Action("Index", "Products", new { area = "Admin" })"
                   class="btn-reset">
                    <i class="glyphicon glyphicon-refresh"></i>
                    Đặt lại
                </a>

            </div>

            <!-- SẮP XẾP -->
            <div class="sort-container">

                <span class="sort-label">
                    <i class="glyphicon glyphicon-sort"></i>
                    Sắp xếp theo:
                </span>

                @Html.ActionLink("Tên A - Z", "Index",
                         new
                         {
                             area = "Admin",
                             sortOrder = "name_asc",
                             searchTerm = Model.SearchTerm,
                             minPrice = Model.MinPrice,
                             maxPrice = Model.MaxPrice
                         },
                         new { @class = "sort-link" })

                @Html.ActionLink("Tên Z - A", "Index",
                         new
                         {
                             area = "Admin",
                             sortOrder = "name_desc",
                             searchTerm = Model.SearchTerm,
                             minPrice = Model.MinPrice,
                             maxPrice = Model.MaxPrice
                         },
                         new { @class = "sort-link" })

                @Html.ActionLink("Giá thấp - cao", "Index",
                         new
                         {
                             area = "Admin",
                             sortOrder = "price_asc",
                             searchTerm = Model.SearchTerm,
                             minPrice = Model.MinPrice,
                             maxPrice = Model.MaxPrice
                         },
                         new { @class = "sort-link" })

                @Html.ActionLink("Giá cao - thấp", "Index",
                         new
                         {
                             area = "Admin",
                             sortOrder = "price_desc",
                             searchTerm = Model.SearchTerm,
                             minPrice = Model.MinPrice,
                             maxPrice = Model.MaxPrice
                         },
                         new { @class = "sort-link" })

            </div>
        }

    </div>

    <!-- DANH SÁCH SẢN PHẨM -->
    <div class="product-list-card">

        <h4 class="list-title">
            <i class="glyphicon glyphicon-list"></i>
            Danh sách sản phẩm
        </h4>

        @Html.Partial("PVListProduct", Model)

    </div>

</div>
