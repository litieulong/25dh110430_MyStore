@model _25dh110430_MyStore.Models.ViewModel.ProductSearchVM

@{
    ViewBag.Title = "Search Product";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <title>Search</title>

    <style>
        .search-container {
            padding-top: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .search-container .form-control {
                width: 500px;
                margin-right: 10px;
            }

        /* Thêm đoạn này để căn giữa dòng sắp xếp */
        .order-container {
            text-align: center;
            margin-top: 15px;
            margin-bottom: 15px;
    </style>
</head>

<body>

    @using (Html.BeginForm("Index", "Products", FormMethod.Get))
    {
        <div class="form-group search-container">
            @*tìm kiếm theo giá và tên sản phẩm*@
            @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Nhập tên, mô tả hoặc chủng loại sản phẩm" })
            @Html.TextBox("minPrice", Model.MinPrice, new { @class = "form-control", placeholder = "Nhập giá tối thiểu", type = "number" })
            @Html.TextBox("maxPrice", Model.MaxPrice, new { @class = "form-control", placeholder = "Nhập giá tối đa", type = "number" })


            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        </div>

        @*tìm kiếm theo thứ tự*@
        <div class="form-group order-container">
            Sắp xếp theo:
            @Html.ActionLink("Tên tăng dần", "Index",
                          new { sortOrder = "name_asc", searchTerm = Model.SearchTerm })
            |
            @Html.ActionLink("Tên giảm dần", "Index",
                          new { sortOrder = "name_desc", searchTerm = Model.SearchTerm })
            |
            @Html.ActionLink("Giá tăng dần", "Index",
                          new { sortOrder = "price_asc", searchTerm = Model.SearchTerm })
            |
            @Html.ActionLink("Giá giảm dần", "Index",
                          new { sortOrder = "price_desc", searchTerm = Model.SearchTerm })
        </div>
    }

    <!-- FORM TÌM KIẾM -->
    @using (Html.BeginForm("Index", "Products", FormMethod.Get))
    {
        <div class="form-group search-container">

            @*@Html.TextBoxFor(m => m.SearchTerm, new
                {
                    @class = "form-control",
                    placeholder = "Nhập tên, mô tả hoặc chủng loại sản phẩm"
                })*@



        </div>
    }

    <!-- HIỂN THỊ KẾT QUẢ -->
    @Html.Partial("PVListProduct", Model)

</body>
</html>