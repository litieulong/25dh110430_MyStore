@model _25dh110430_MyStore.Models.ViewModel.ProductCreateVM

<style>
    textarea {
        width: 100%;
        height: 150px;
        padding: 12px 5px;
        box-sizing: border-box;
        border: 1px solid #9d9595;
        border-radius: 10px;
        background-color: whitesmoke;
        resize: none;
    }

    .color-box {
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 15px;
        background-color: #f9f9f9;
    }

    .color-title {
        font-weight: bold;
        margin-bottom: 10px;
    }
</style>


<!-- DANH MỤC -->
<div class="form-group">

    <div class="control-label col-md-2">
        Danh mục
    </div>

    <div class="col-md-10">

        @Html.DropDownList(
                                                    "CategoryID",
                                                    null,
                                                    htmlAttributes: new { @class = "form-control" })

        @Html.ValidationMessageFor(
                                                    model => model.CategoryID,
                                                    "",
                                                    new { @class = "text-danger" })

    </div>

</div>


<!-- TÊN SẢN PHẨM -->
<div class="form-group">

    <div class="control-label col-md-2">
        Tên sản phẩm
    </div>

    <div class="col-md-10">

        @Html.EditorFor(
                                                    model => model.ProductName,
                                                    new
                                                    {
                                                        htmlAttributes = new
                                                        {
                                                            @class = "form-control"
                                                        }
                                                    })

        @Html.ValidationMessageFor(
                                                    model => model.ProductName,
                                                    "",
                                                    new { @class = "text-danger" })

    </div>

</div>


<!-- ĐƠN GIÁ -->
<div class="form-group">
    <div class="control-label col-md-2">
        Đơn giá
    </div>

    <div class="col-md-10">
        @Html.TextBoxFor(
                 model => model.ProductPrice,
                 new
                 {
                     @class = "form-control",
                     type = "number",
                     min = "0",
                     step = "1000",
                     placeholder = "Nhập giá bằng VNĐ"
                 })

        @Html.ValidationMessageFor(
                 model => model.ProductPrice,
                 "",
                 new { @class = "text-danger" })
    </div>
</div>

<!-- SỐ LƯỢNG TỒN KHO -->
<div class="form-group">

    <div class="control-label col-md-2">
        Số lượng tồn kho
    </div>

    <div class="col-md-10">

        @Html.TextBoxFor(
                      model => model.StockQuantity,
                      new
                      {
                          @class = "form-control",
                          type = "number",
                          min = "0"
                      })

        @Html.ValidationMessageFor(
                      model => model.StockQuantity,
                      "",
                      new { @class = "text-danger" })

    </div>
</div>


<!-- MÔ TẢ -->
<div class="form-group">

    <div class="control-label col-md-2">
        Mô tả
    </div>

    <div class="col-md-10">

        @Html.TextAreaFor(
                                                    model => model.ProductDescription,
                                                    new
                                                    {
                                                        @class = "form-control"
                                                    })

        @Html.ValidationMessageFor(
                                                    model => model.ProductDescription,
                                                    "",
                                                    new { @class = "text-danger" })

    </div>

</div>


<hr />

<!-- MÀU SẮC -->
<h3>Màu sắc và hình ảnh</h3>

<div id="colors-container">

    <div class="color-box">

        <div class="color-title">
            Màu 1
        </div>

        <div class="form-group">

            <div class="control-label col-md-2">
                Tên màu
            </div>

            <div class="col-md-10">

                <input type="text"
                       name="Colors[0].ColorName"
                       class="form-control"
                       placeholder="Ví dụ: Đen" />

            </div>

        </div>

        <div class="form-group">

            <div class="control-label col-md-2">
                Hình ảnh
            </div>

            <div class="col-md-10">

                <input type="text"
                       name="Colors[0].Images[0]"
                       class="form-control"
                       placeholder="Nhập link hình ảnh" />

            </div>

        </div>

    </div>

</div>

<div class="form-group">

    <div class="col-md-offset-2 col-md-10">

        <button type="button"
                id="btnAddColor"
                class="btn btn-success">

            + Thêm màu

        </button>

    </div>

</div>


<br />

@*LƯU*@
<div class="form-group">

    <div class="col-md-offset-2 col-md-10">

        <input type="submit"
               value="Lưu"
               class="btn btn-primary" />

    </div>

</div>


<script>

    let colorIndex = 1;

    document.getElementById("btnAddColor")
        .addEventListener("click", function () {

            let container =
                document.getElementById("colors-container");

            let div =
                document.createElement("div");

            div.className = "color-box";

            div.innerHTML = `

                    <div class="color-title">
                        Màu ${colorIndex + 1}
                    </div>

                    <div class="form-group">

                        <div class="control-label col-md-2">
                            Tên màu
                        </div>

                        <div class="col-md-10">

                            <input type="text"
                                   name="Colors[${colorIndex}].ColorName"
                                   class="form-control"
                                   placeholder="Ví dụ: Xám" />

                        </div>

                    </div>

                    <div class="form-group">

                        <div class="control-label col-md-2">
                            Hình ảnh
                        </div>

                        <div class="col-md-10">

                            <input type="text"
                                   name="Colors[${colorIndex}].Images[0]"
                                   class="form-control"
                                   placeholder="Nhập link hình ảnh" />

                        </div>

                    </div>

                `;

            container.appendChild(div);

            colorIndex++;

        });

</script>
