
@model _25dh110430_MyStore.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc;
@using System.Linq;

<style>
    /* KHUNG DANH SÁCH */
   /* .admin-product-list {
        width: 100%;
    }*/

    /* PHẦN ĐẦU DANH SÁCH */
    .admin-product-list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 22px;
    }

    .admin-product-list-title {
        font-size: 18px;
        font-weight: 700;
        color: #263f53;
        margin: 0;
    }

    /* NÚT THÊM MỚI */
    .admin-product-add {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px 20px;
        background: #263f53;
        color: white;
        border-radius: 7px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .admin-product-add:hover {
            background: #385b75;
            color: white;
            text-decoration: none;
        }

    /* BẢNG SẢN PHẨM */
    .admin-product-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .admin-product-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        margin-bottom: 0;
    }

        .admin-product-table thead {
            background: #f1f4f8;
        }

        .admin-product-table th {
            padding: 16px 14px;
            color: #536176;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            border: none;
            white-space: nowrap;
        }

        .admin-product-table td {
            padding: 14px;
            color: #263f53;
            font-size: 14px;
            vertical-align: middle !important;
            border-top: 1px solid #edf0f4;
        }

        .admin-product-table tbody tr:hover {
            background: #f8fafc;
        }

    /* HÌNH ẢNH */
    .admin-product-image {
        width: 85px;
        height: 85px;
        object-fit: contain;
        background: #f7f9fb;
        border-radius: 8px;
        padding: 5px;
    }

    /* TÊN SẢN PHẨM */
    .admin-product-name {
        font-weight: 600;
        color: #263f53;
        min-width: 150px;
    }

    /* GIÁ */
    .admin-product-price {
        color: #e05252;
        font-weight: 700;
        white-space: nowrap;
    }

    /* DANH MỤC */
    .admin-product-category {
        color: #718096;
    }

    /* NHÓM NÚT */
    .admin-product-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

        .admin-product-actions a {
            display: inline-block;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: 0.2s;
        }

    /* NÚT SỬA */
    .admin-btn-edit {
        background: #e8f2fc;
        color: #2875b8;
    }

        .admin-btn-edit:hover {
            background: #d5e8fa;
            color: #1d5d96;
        }

    /* NÚT CHI TIẾT */
    .admin-btn-detail {
        background: #eef1f5;
        color: #536176;
    }

        .admin-btn-detail:hover {
            background: #dfe4ea;
            color: #263f53;
        }

    /* NÚT XÓA */
    .admin-btn-delete {
        background: #fdebea;
        color: #d9534f;
    }

        .admin-btn-delete:hover {
            background: #f9d8d6;
            color: #bd3632;
        }

    /* KHÔNG CÓ SẢN PHẨM */
    .admin-product-empty {
        padding: 35px 15px;
        text-align: center;
        color: #8993a4;
        background: #f8fafc;
        border-radius: 8px;
    }

    /* PHÂN TRANG */
    .admin-product-pagination {
        display: flex;
        justify-content: center;
        margin-top: 25px;
    }

        .admin-product-pagination .pagination {
            margin: 0;
        }

            .admin-product-pagination .pagination > li > a,
            .admin-product-pagination .pagination > li > span {
                color: #263f53;
                border-color: #e1e6ed;
                border-radius: 5px;
                margin: 0 3px;
            }

            .admin-product-pagination .pagination > .active > a,
            .admin-product-pagination .pagination > .active > span {
                background: #263f53;
                border-color: #263f53;
                color: white;
            }

    @@media (max-width: 768px) {
        .admin-product-list-header {
            align-items: flex-start;
        }

        .admin-product-table th,
        .admin-product-table td {
            padding: 10px;
        }

        .admin-product-image {
            width: 65px;
            height: 65px;
        }
    }
</style>

<div class="admin-product-list">

    <!-- TIÊU ĐỀ VÀ NÚT THÊM -->
    <div class="admin-product-list-header">

        <a href="@Url.Action("Create", "Products", new { area = "Admin" })"
           class="admin-product-add">
            <i class="glyphicon glyphicon-plus"></i>
            Thêm sản phẩm
        </a>

    </div>

    @if (Model.Products != null && Model.Products.Any())
    {
        <div class="admin-product-table-wrapper">

            <table class="admin-product-table">

                <thead>
                    <tr>
                        <th style="width: 120px;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Danh mục</th>
                        <th style="width: 230px;">Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var product in Model.Products)
                    {
                        <tr>

                            <td>
                                @if (!string.IsNullOrEmpty(product.ProductImage))
                                {
                                    <img src="@product.ProductImage"
                                         alt="@product.ProductName"
                                         class="admin-product-image" />
                                }
                                else
                                {
                                    <div class="admin-product-image"></div>
                                }
                            </td>

                            <td>
                                <div class="admin-product-name">
                                    @product.ProductName
                                </div>
                            </td>

                            <td>
                                <span class="admin-product-price">
                                    @product.ProductPrice.ToString(
                                             "#,##0",
                                             new System.Globalization.CultureInfo("vi-VN")
                                         ) VNĐ
                                </span>
                            </td>

                            <td>
                                <span class="admin-product-category">
                                    @(product.Category != null
                                        ? product.Category.CategoryName
                                        : "Chưa có danh mục")
                                </span>
                            </td>

                            <td>
                                <div class="admin-product-actions">

                                    @Html.ActionLink(
                                             "Sửa",
                                             "Edit",
                                             new { area = "Admin", id = product.ProductID },
                                             new { @class = "admin-btn-edit" }
                                         )

                                    @Html.ActionLink(
                                             "Chi tiết",
                                             "Details",
                                             new { area = "Admin", id = product.ProductID },
                                             new { @class = "admin-btn-detail" }
                                         )

                                    @Html.ActionLink(
                                             "Xóa",
                                             "Delete",
                                             new { area = "Admin", id = product.ProductID },
                                             new { @class = "admin-btn-delete" }
                                         )

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- PHÂN TRANG -->
        <div class="admin-product-pagination">

            @Html.PagedListPager(Model.Products, page => Url.Action("Index", new
            {
                area = "Admin",
                page,
                searchTerm = Model.SearchTerm,
                minPrice = Model.MinPrice,
                maxPrice = Model.MaxPrice,
                sortOrder = Model.SortOrder
            }))

        </div>
    }
    else
    {
        <div class="admin-product-empty">
            <i class="glyphicon glyphicon-search"
               style="font-size: 30px;"></i>

            <h4>Không tìm thấy sản phẩm</h4>

            <p>Vui lòng thử lại với từ khóa hoặc điều kiện tìm kiếm khác.</p>
        </div>
    }

</div>
