@model _25dh110430_MyStore.Models.Customer

@{
    ViewBag.Title = "Chi tiết khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<style>
    .customer-detail-container {
        background: #f5f6f8;
        min-height: 100vh;
        padding: 30px;
        border-radius: 12px;
    }

    .detail-card {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.06);
        max-width: 850px;
        margin: auto;
    }

    .detail-title {
        font-size: 25px;
        font-weight: 700;
        color: #344054;
        padding-bottom: 18px;
        border-bottom: 1px solid #e9ecef;
        margin-bottom: 25px;
    }

    .detail-row {
        display: flex;
        padding: 15px 0;
        border-bottom: 1px solid #f0f1f3;
    }

    .detail-label {
        width: 200px;
        font-weight: 600;
        color: #667085;
    }

    .detail-value {
        flex: 1;
        color: #344054;
    }

    .btn-back {
        display: inline-block;
        margin-top: 25px;
        padding: 10px 18px;
        background: #475467;
        color: white;
        border-radius: 7px;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #344054;
            color: white;
            text-decoration: none;
        }

    @@media(max-width: 600px) {
        .detail-row {
            flex-direction: column;
            gap: 6px;
        }

        .detail-label {
            width: 100%;
        }

        .customer-detail-container {
            padding: 12px;
        }
    }
</style>

<div class="customer-detail-container">

    <div class="detail-card">

        <h2 class="detail-title">
            <i class="fa fa-user"></i>
            CHI TIẾT KHÁCH HÀNG
        </h2>

        @if (Model != null)
        {
            <div class="detail-row">
                <div class="detail-label">Mã khách hàng</div>
                <div class="detail-value">@Model.CustomerID</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Username</div>
                <div class="detail-value">@Model.Username</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Họ và tên</div>
                <div class="detail-value">@Model.CustomerName</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Số điện thoại</div>
                <div class="detail-value">@Model.CustomerPhone</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Email</div>
                <div class="detail-value">@Model.CustomerEmail</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Địa chỉ</div>
                <div class="detail-value">@Model.CustomerAddress</div>
            </div>
        }
        else
        {
            <p>Không tìm thấy thông tin khách hàng.</p>
        }

        <a href="@Url.Action("Index", "Customers", new { area = "Admin" })"
           class="btn-back">
            <i class="fa fa-arrow-left"></i>
            Quay lại
        </a>

    </div>

</div>
