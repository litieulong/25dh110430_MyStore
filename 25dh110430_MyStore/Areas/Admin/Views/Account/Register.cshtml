@{
    ViewBag.Title = "Đăng ký Admin";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<style>
    .register-container {
        max-width: 600px;
        margin: 40px auto;
        padding: 35px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.08);
    }

    .register-title {
        font-size: 28px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 30px;
    }

    .register-container .form-control {
        padding: 12px;
        margin-bottom: 20px;
    }

    .btn-register {
        width: 100%;
        padding: 12px;
        background: #198754;
        color: white;
        border: none;
        border-radius: 7px;
        font-weight: bold;
    }

        .btn-register:hover {
            background: #146c43;
        }
</style>

<div class="register-container">

    <h2 class="register-title">ĐĂNG KÝ ADMIN</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success">
            @ViewBag.Success
        </div>
    }

    @using (Html.BeginForm("Register", "Account",
        new { area = "Admin" }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <label class="form-label">Tên đăng nhập</label>

        <input type="text"
               name="username"
               class="form-control"
               placeholder="Nhập username..."
               required />

        <label class="form-label">Mật khẩu</label>

        <input type="password"
               name="password"
               class="form-control"
               placeholder="Nhập mật khẩu..."
               required
               minlength="6" />

        <button type="submit" class="btn-register">
            TẠO TÀI KHOẢN ADMIN
        </button>
    }

</div>