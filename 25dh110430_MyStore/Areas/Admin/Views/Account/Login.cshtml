@{
    ViewBag.Title = "Đăng nhập Admin";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập Admin - My Store</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #1f2937, #198754);
            font-family: Arial, sans-serif;
        }

        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 35px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .login-title {
            text-align: center;
            font-size: 27px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .login-subtitle {
            text-align: center;
            color: #777;
            margin-bottom: 30px;
        }

        .form-control {
            padding: 12px;
            margin-bottom: 18px;
        }

        .btn-login {
            width: 100%;
            padding: 12px;
            font-weight: bold;
            background: #198754;
            color: white;
            border: none;
            border-radius: 7px;
        }

            .btn-login:hover {
                background: #146c43;
            }
    </style>
</head>

<body>
    <div class="login-container">

        <div class="login-title">MY STORE ADMIN</div>

        <div class="login-subtitle">
            Đăng nhập vào hệ thống quản trị
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("Login", "Account",
            new { area = "Admin" }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <label class="form-label">Tên đăng nhập</label>

            <input type="text"
                   name="username"
                   class="form-control"
                   placeholder="Nhập username..."
                   required />

            <label class="form-label">Mật khẩu</label>

            <input type="password"
                   name="password"
                   class="form-control"
                   placeholder="Nhập mật khẩu..."
                   required />

            <button type="submit" class="btn-login">
                ĐĂNG NHẬP
            </button>
        }

    </div>
</body>
</html>